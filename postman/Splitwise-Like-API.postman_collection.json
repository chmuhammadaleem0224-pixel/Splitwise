{
    "info": {
        "name": "Splitwise-Like API",
        "description": "Postman workflow for auth, groups, members, expenses, balances, debts, and settlements. Register each test user once, then use Login requests on later runs.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
        { "key": "token", "value": "" },
        { "key": "owner_id", "value": "" },
        { "key": "member_user_id", "value": "" },
        { "key": "group_id", "value": "" },
        { "key": "expense_id", "value": "" }
    ],
    "item": [
        {
            "name": "1. Register Owner (run once)",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.data.token);", "pm.environment.set('token', body.data.token);", "pm.collectionVariables.set('owner_id', body.data.user.id);", "pm.environment.set('owner_id', body.data.user.id);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Owner\",\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/register" }
        },
        {
            "name": "2. Register Member (run once)",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('member_user_id', body.data.user.id);", "pm.environment.set('member_user_id', body.data.user.id);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Member\",\n  \"email\": \"member@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/register" }
        },
        {
            "name": "3. Login Owner",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.data.token);", "pm.environment.set('token', body.data.token);", "pm.collectionVariables.set('owner_id', body.data.user.id);", "pm.environment.set('owner_id', body.data.user.id);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/login" }
        },
        {
            "name": "4. Current User",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/me" }
        },
        {
            "name": "5. List Groups",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups" }
        },
        {
            "name": "6. Create Group",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('group_id', body.data.id);", "pm.environment.set('group_id', body.data.id);", "pm.collectionVariables.set('owner_id', body.data.owner_id);", "pm.environment.set('owner_id', body.data.owner_id);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Test Group\",\n  \"description\": \"Group created from Postman\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/groups" }
        },
        {
            "name": "7. Get Group",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}" }
        },
        {
            "name": "8. Add Member",
            "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"user_id\": \"{{member_user_id}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/groups/{{group_id}}/members" }
        },
        {
            "name": "9. List Group Members",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}/members" }
        },
        {
            "name": "10. Create Equal Expense",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('expense_id', body.data._id || body.data.id);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Dinner\",\n  \"amount\": 12000,\n  \"paid_by\": \"{{owner_id}}\",\n  \"split_type\": \"equal\",\n  \"participants\": [\n    { \"user_id\": \"{{owner_id}}\" },\n    { \"user_id\": \"{{member_user_id}}\" }\n  ]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/groups/{{group_id}}/expenses" }
        },
        {
            "name": "11. List Group Expenses",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}/expenses" }
        },
        {
            "name": "12. Get Expense",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/expenses/{{expense_id}}" }
        },
        {
            "name": "13. Get Balances",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}/balances" }
        },
        {
            "name": "14. Get Simplified Debts",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}/debts" }
        },
        {
            "name": "15. Login Member",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.data.token);", "pm.environment.set('token', body.data.token);", "pm.collectionVariables.set('member_user_id', body.data.user.id);", "pm.environment.set('member_user_id', body.data.user.id);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"member@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/login" }
        },
        {
            "name": "16. Create Settlement (Member pays Owner)",
            "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"paid_to\": \"{{owner_id}}\",\n  \"amount\": 6000,\n  \"note\": \"Postman test settlement\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/groups/{{group_id}}/settlements" }
        },
        {
            "name": "17. List Settlements",
            "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}/settlements" }
        },
        {
            "name": "18. Login Owner Again",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('token', body.data.token);", "pm.environment.set('token', body.data.token);"] } }],
            "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"password123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{base_url}}/login" }
        },
        {
            "name": "19. Remove Member",
            "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/groups/{{group_id}}/members/{{member_user_id}}" }
        },
        {
            "name": "20. Logout",
            "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.unset('token');", "pm.environment.unset('token');"] } }],
            "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/logout" }
        }
    ]
}
